# Normalise line endings so that the JavaScript, CSS, HTML and Markdown files behave the same
# on Windows, Linux and macOS.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF.
*.sh text eol=lf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
